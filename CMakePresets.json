{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host debug tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "pico2-release",
      "displayName": "Pico 2 release firmware",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/pico2-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MIDI_PEDAL_BUILD_FIRMWARE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug" },
    { "name": "pico2-release", "configurePreset": "pico2-release" }
  ],
  "testPresets": [
    { "name": "host-debug", "configurePreset": "host-debug", "output": { "outputOnFailure": true } }
  ]
}
